{
  "name": "govent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma db push --force-reset && npx prisma db seed"
